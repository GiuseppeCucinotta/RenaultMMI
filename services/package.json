{
  "name": "@renault-mmi/services",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local HTTP/SSE backends (jukebox, bluetooth, cd, settings) spawned by the Electron app",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "bluetooth:debug": "tsx bluetooth-service/index.ts",
    "cd:debug": "tsx cd-service/index.ts"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "fast-glob": "^3.3.3",
    "music-metadata": "^11.10.6",
    "node-mpv": "^2.0.0-beta.2",
    "p-limit": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.6"
  }
}
